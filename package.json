{
  "name": "notebooklm-clone",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}