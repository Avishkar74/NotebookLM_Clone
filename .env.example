# ─── CORE LLM SETTINGS (Require at least one OpenAI-compatible key) ───
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
CHATANYWHERE_API_KEY=sk-your-chatanywhere-key-here
BASE_URL=https://api.chatanywhere.org/v1
MODEL=gpt-4o-mini

# ─── VECTOR DATABASE (Milvus / Zilliz Cloud) ───
MILVUS_URI=https://in03-....serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_TOKEN=your-zilliz-token-here

# ─── EXTERNAL SERVICE INTEGRATIONS (Optional but recommended) ───
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-key
ZEP_API_KEY=z_your-zep-api-key

# ─── SERVER SETTINGS ───
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ─── APP DEFAULTS ───
DEFAULT_USER_ID=notebook-user
DEFAULT_SESSION_ID=default-session
DEFAULT_USER_NAME=YourName

# ─── ALTERNATIVE LLMS (Optional/Experimental) ───
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
LIGHTNING_API_KEY=...
